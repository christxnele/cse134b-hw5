<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="{{ description }}" />
    <link rel="stylesheet" href="style.css">
    <!-- no defer: applies the saved theme before the page paints -->
    <script src="theme.js"></script>
    <title>Christine Le | {{ title }}</title>
  </head>
  <body>
    <noscript>
      <p>
        JavaScript is turned off. Everything still works, but the light/dark theme switch isn't available.
      </p>
    </noscript>

    <header class="nav">
      <a href="index.html">Christine Le</a>
      <nav>
        <ul class="header-links">
          <li><a href="index.html">Home</a></li>
          <li><a href="about.html">About</a></li>
          <li class="theme-item" hidden>
            <button
              type="button"
              id="theme-toggle"
              class="theme-toggle"
              aria-label="Dark theme"
              aria-pressed="false"
              title="Toggle dark theme"
            >
              <!-- moon: shown in light theme -->
              <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
              </svg>
              <!-- sun: shown in dark theme -->
              <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
              </svg>
            </button>
          </li>        
        </ul>
      </nav>
    </header>

    {{ content | safe }}

    {% include "footer.njk" %}
  </body>
</html>